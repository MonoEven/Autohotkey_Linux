#!/bin/sh
# AutoHotkey v2 Linux port launcher (shared template).
# Substituted by install.sh and pack.sh: @PREFIX@, @LIB_SUB@, @BIN_SUB@,
# @DOC_SUB@, @AHK_VERSION@ (e.g. "2.0.26-linux.17").  Installed as
# <prefix>/bin/ahk (tarball) or /usr/bin/ahk (deb).
#
# Commands are all "--" prefixed so plain names (e.g. `ahk check.ahk`,
# `ahk update.ahk`) are passed to the interpreter as scripts, never
# interpreted as built-ins.
#
#   ahk script.ahk            run a script with the interpreter
#   ahk --version             print the port version, incl. the release
#   ahk --help                show this help
#   ahk --check               integrity / install method / latest release
#   ahk --uninstall           cleanly remove this installation
#   ahk --update [VER]        update (or downgrade) to latest / given release
#                              (VER like 2.0.26-linux.17; blank = latest)
AHK_PREFIX="@PREFIX@"
AHK_VERSION="@AHK_VERSION@"
AHK_LIB="$AHK_PREFIX/@LIB_SUB@"
AHK_BIN="$AHK_PREFIX/@BIN_SUB@"
AHK_DOC="$AHK_PREFIX/@DOC_SUB@"

# True when this prefix carries the Debian/Ubuntu package (dpkg state).
is_deb() {
  [ "$AHK_PREFIX" = "/usr" ] && command -v dpkg >/dev/null 2>&1 \
    && dpkg -l autohotkey-linux >/dev/null 2>&1
}

# True when the prefix carries the Fedora/openSUSE RPM (rpm db state).
is_rpm() {
  [ "$AHK_PREFIX" = "/usr" ] && command -v rpm >/dev/null 2>&1 \
    && rpm -q autohotkey-linux >/dev/null 2>&1
}

# True when the prefix carries the Arch Linux package (pacman db state).
is_pacman() {
  [ "$AHK_PREFIX" = "/usr" ] && command -v pacman >/dev/null 2>&1 \
    && pacman -Q autohotkey-linux >/dev/null 2>&1
}

# Install method for --check/--update/--uninstall messages.
install_method() {
  if is_deb; then echo "Debian/Ubuntu package (dpkg)";
  elif is_rpm; then echo "RPM package (rpm/dnf)";
  elif is_pacman; then echo "Arch Linux package (pacman)";
  else echo "tarball (install.sh)"; fi
}

cmd="${1:-}"
case "$cmd" in
  --version|-v)
    if [ -n "$AHK_VERSION" ]; then
      echo "AutoHotkey v2.0.26 Linux port v$AHK_VERSION"
    else
      echo "AutoHotkey v2.0.26 Linux port (unknown release)"
    fi
    exit 0
    ;;
  --help|-h)
    echo "AutoHotkey v2 Linux port launcher"
    echo "Usage: ahk [OPTION] [script.ahk [args...]]"
    echo "  --version, -v      print the port version (incl. release) and exit"
    echo "  --check            check install integrity, method and latest release"
    echo "  --uninstall        cleanly remove this installation"
    echo "  --update [VER]     update (or downgrade) to the latest / given release"
    echo "  --help, -h         show this help"
    echo "Anything else is treated as a script name and given to the interpreter."
    exit 0
    ;;
  --check)
    echo "ahk --check: AutoHotkey v2 Linux port"
    echo "  installed version : ${AHK_VERSION:-unknown}"
    echo "  prefix            : $AHK_PREFIX"
    echo "  interpreter       : $AHK_LIB/ahk_core"
    if is_deb; then
      echo "  install method    : Debian/Ubuntu package (dpkg)"
    elif is_rpm; then
      echo "  install method    : RPM package (rpm/dnf)"
    elif is_pacman; then
      echo "  install method    : Arch Linux package (pacman)"
    else
      echo "  install method    : tarball (install.sh)"
    fi
    # Integrity of the core files.
    ok=1
    if [ ! -e "$AHK_LIB/ahk_core" ]; then echo "  MISSING           : $AHK_LIB/ahk_core"; ok=0; fi
    [ -x "$AHK_LIB/ahk_core" ] || { echo "  NOT EXECUTABLE    : $AHK_LIB/ahk_core"; ok=0; }
    if [ ! -e "$AHK_BIN/ahk" ]; then echo "  MISSING           : $AHK_BIN/ahk"; ok=0; fi
    if [ "$AHK_VERSION" != "@AHK_VERSION@" ] && [ -n "$AHK_VERSION" ]; then
      [ "$AHK_VERSION" = "unknown" ] || {
        if [ ! -f "$AHK_BIN/ahk" ] || [ "$(dirname "$AHK_BIN/ahk")" != "$AHK_BIN" ]; then :; fi
      }
    fi
    if [ "$ok" = 1 ]; then echo "  integrity         : OK"; else echo "  integrity         : PROBLEMS FOUND"; fi
    # Docs present? (informational)
    if [ -d "$AHK_DOC" ]; then echo "  docs              : $AHK_DOC"; else echo "  docs              : (none)"; fi
    # GNOME Shell extension state (informational; the extension is a separate
    # user-scoped component -- install/update/uninstall never touch it).
    extid="ahk-global-hotkeys@autohotkey.org"
    if [ -d "$HOME/.local/share/gnome-shell/extensions/$extid" ]; then
      echo "  GNOME extension   : installed (~/.local/share/gnome-shell/extensions)"
    elif [ -d "/usr/share/gnome-shell/extensions/$extid" ]; then
      echo "  GNOME extension   : installed (system-wide)"
    else
      echo "  GNOME extension   : not installed (optional; needed for GNOME Wayland hotkeys)"
    fi
    if command -v gnome-extensions >/dev/null 2>&1; then
      if command -v timeout >/dev/null 2>&1; then
        en=$(timeout 3 gnome-extensions list --enabled 2>/dev/null)
      else
        en=$(gnome-extensions list --enabled 2>/dev/null)
      fi
      if printf '%s\n' "$en" | grep -Fqx "$extid"; then
        echo "  GNOME extension   : enabled"
      else
        echo "  GNOME extension   : disabled"
      fi
    fi
    # Latest release from GitHub.
    if command -v curl >/dev/null 2>&1; then
      tag=$(curl -fsSL --connect-timeout 15 "https://api.github.com/repos/MonoEven/Autohotkey_Linux/releases/latest" 2>/dev/null)
    elif command -v wget >/dev/null 2>&1; then
      tag=$(wget -qO- --timeout=15 "https://api.github.com/repos/MonoEven/Autohotkey_Linux/releases/latest" 2>/dev/null)
    else
      tag=""
    fi
    latest=$(printf '%s\n' "$tag" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$latest" ]; then
      echo "  latest release    : v$latest"
      cur=$(printf '%s\n' "$AHK_VERSION" | sed 's/^v//')
      if [ -n "$cur" ] && [ "$cur" != "unknown" ] && [ "$cur" != "$latest" ]; then
        if is_deb; then
          echo "  update available  : yes (use apt or install the new .deb)"
        else
          echo "  update available  : yes (ahk --update)"
        fi
      else
        echo "  update available  : no (up to date)"
      fi
    else
      echo "  latest release    : (could not reach GitHub)"
    fi
    exit 0
    ;;
  --uninstall)
    if ! [ -f "$AHK_BIN/ahk" ]; then
      echo "ahk: no installation found at $AHK_PREFIX" >&2
      exit 1
    fi
    # If this wrapper came from the Debian/Ubuntu package, prefer dpkg so
    # the package state stays consistent.
    if is_deb; then
      echo "This installation is the Debian package 'autohotkey-linux'."
      echo "Remove it with:  sudo apt remove autohotkey-linux"
      exit 1
    fi
    if is_rpm; then
      echo "This installation is the RPM package 'autohotkey-linux'."
      echo "Remove it with:  sudo dnf remove autohotkey-linux   (Fedora/openSUSE)"
      exit 1
    fi
    if is_pacman; then
      echo "This installation is the Arch package 'autohotkey-linux'."
      echo "Remove it with:  sudo pacman -Rns autohotkey-linux"
      exit 1
    fi
    echo "Removing AutoHotkey v2 Linux port from $AHK_PREFIX ..."
    rm -f "$AHK_BIN/ahk" "$AHK_BIN/ahk_core" \
          "$AHK_LIB/ahk_core" "$AHK_LIB/ahk.ahk" 2>/dev/null || true
    rm -rf "$AHK_LIB" "$AHK_DOC" 2>/dev/null || true
    # Prune empty directories from the deepest known one upward (e.g.
    # share/doc -> share -> prefix) so the removal is clean.  Never touch
    # "/" or the home directory itself.
    d=$(dirname "$AHK_DOC")
    while [ "$d" != "/" ] && [ "$d" != "$HOME" ]; do
      rmdir "$d" 2>/dev/null || break
      d=$(dirname "$d")
    done
    echo "Done.  AutoHotkey has been uninstalled."
    # The GNOME Shell extension is user-scoped and intentionally not part of
    # the core install: uninstall leaves it in place (see Install.htm).
    extid="ahk-global-hotkeys@autohotkey.org"
    if [ -d "$HOME/.local/share/gnome-shell/extensions/$extid" ] \
       || [ -d "/usr/share/gnome-shell/extensions/$extid" ]; then
      echo "Note: the optional GNOME Shell extension is not managed by this"
      echo "uninstall and is still installed.  To remove it:"
      echo "  gnome-extensions disable $extid"
      echo "  rm -rf ~/.local/share/gnome-shell/extensions/$extid"
    fi
    exit 0
    ;;
  --update)
    ver="${2:-}"
    if is_deb; then
      echo "This installation is the Debian package 'autohotkey-linux'."
      echo "Update it with:  sudo apt update && sudo apt install --only-upgrade autohotkey-linux"
      echo "(or download the new .deb from the GitHub release and run: sudo apt install ./autohotkey-linux-<ver>-amd64.deb)"
      exit 1
    fi
    if is_rpm; then
      echo "This installation is the RPM package 'autohotkey-linux'."
      echo "Update it with:  sudo dnf update autohotkey-linux"
      echo "(or: download the new .rpm from the GitHub release and run sudo dnf install ./autohotkey-linux-<ver>-<arch>.rpm)"
      exit 1
    fi
    if is_pacman; then
      echo "This installation is the Arch package 'autohotkey-linux'."
      echo "Update it with:  sudo pacman -Syu"
      exit 1
    fi
    if [ -z "$ver" ]; then
      # Resolve the latest release tag from the GitHub API.
      if command -v curl >/dev/null 2>&1; then
        tag=$(curl -fsSL --connect-timeout 15 \
          "https://api.github.com/repos/MonoEven/Autohotkey_Linux/releases/latest" 2>/dev/null)
      elif command -v wget >/dev/null 2>&1; then
        tag=$(wget -qO- --timeout=15 \
          "https://api.github.com/repos/MonoEven/Autohotkey_Linux/releases/latest" 2>/dev/null)
      else
        echo "ahk: --update needs curl or wget" >&2
        exit 1
      fi
      ver=$(printf '%s\n' "$tag" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\([^"]*\)".*/\1/p' | head -1)
      [ -n "$ver" ] || { echo "ahk: could not determine the latest version" >&2; exit 1; }
    fi
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    asset="autohotkey-linux-$ver-amd64.tar.gz"
    url="https://github.com/MonoEven/Autohotkey_Linux/releases/download/v$ver/$asset"
    echo "Downloading AutoHotkey v$ver ..."
    # Package CI and downstream mirrors can provide a local release directory;
    # normal users keep the GitHub path above.  This also lets a new release
    # verify its updater before the GitHub asset is published.
    if [ -n "${AHK_RELEASE_DIR:-}" ]; then
      cp "$AHK_RELEASE_DIR/$asset" "$tmp/ahk.tar.gz"
    elif command -v curl >/dev/null 2>&1; then
      curl -fsSL --connect-timeout 20 -o "$tmp/ahk.tar.gz" "$url" ||
        curl -fsSL --connect-timeout 40 -o "$tmp/ahk.tar.gz" "$url"
    else
      wget -q --timeout=60 -O "$tmp/ahk.tar.gz" "$url"
    fi
    [ -s "$tmp/ahk.tar.gz" ] || { echo "ahk: download failed for v$ver" >&2; exit 1; }
    tar xzf "$tmp/ahk.tar.gz" -C "$tmp" || { echo "ahk: bad archive" >&2; exit 1; }
    inst=$(cd "$tmp" && find . -path '*/tools/linux/install.sh' -print -quit)
    [ -n "$inst" ] || { echo "ahk: installer not found in the archive" >&2; exit 1; }
    instdir=$(dirname "$inst")
    echo "Installing v$ver over $AHK_PREFIX ..."
    if [ -w "$AHK_PREFIX" ]; then
      ( cd "$tmp/$instdir" && ./install.sh --prefix "$AHK_PREFIX" --yes )
      rc=$?
    elif command -v sudo >/dev/null 2>&1; then
      echo "($AHK_PREFIX is not writable by you; using sudo)"
      ( cd "$tmp/$instdir" && sudo ./install.sh --prefix "$AHK_PREFIX" --yes )
      rc=$?
    else
      echo "ahk: $AHK_PREFIX is not writable and sudo is unavailable" >&2
      rc=1
    fi
    # IMPORTANT: the downloaded tarball may carry an older install.sh that
    # writes a bare wrapper (no --update/--check/--version handling).  We
    # always restore the full launcher from the current installation and
    # re-stamp the new release, so the command set stays identical no matter
    # which direction (upgrade or downgrade) we went.
    if [ "$rc" = 0 ] && [ -f "$AHK_BIN/ahk" ]; then
      cp "$0" "$AHK_BIN/ahk.new" 2>/dev/null || true
      if [ -f "$AHK_BIN/ahk.new" ]; then
        sed -e "s|^AHK_PREFIX=.*|AHK_PREFIX=\"$AHK_PREFIX\"|" \
            -e "s|^AHK_VERSION=.*|AHK_VERSION=\"$ver\"|" \
            "$AHK_BIN/ahk.new" > "$AHK_BIN/ahk" 2>/dev/null || true
        chmod 0755 "$AHK_BIN/ahk"
        rm -f "$AHK_BIN/ahk.new"
      fi
    fi
    if [ "$rc" = 0 ]; then
      echo "AutoHotkey updated to v$ver."
    else
      echo "ahk: update installer failed (rc=$rc)" >&2
    fi
    exit "$rc"
    ;;
esac
exec "$AHK_LIB/ahk_core" "$@"
