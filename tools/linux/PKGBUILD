# Maintainer: MonoEven <MonoEven@users.noreply.github.com>
# Contributor: AutoHotkey Linux port
# Arch Linux PKGBUILD for the AutoHotkey v2 Linux port (v2 syntax only).
# Bump pkgver+source to the newest release tag when packaging a new
# release; the pinned tag keeps the build reproducible (check0820).
pkgname=autohotkey-linux
pkgver=2.0.26.linux.17
pkgrel=1
pkgdesc="AutoHotkey v2 automation for Linux (X11/Wayland, v2 only)"
arch=('x86_64' 'aarch64')
url="https://github.com/MonoEven/Autohotkey_Linux"
license=('GPL2')
depends=('libx11' 'libxext' 'libxrandr' 'libxinerama' 'libxtst'
         'libxi' 'wayland' 'libxkbcommon' 'libxkbcommon-x11')
makedepends=('cmake' 'ninja' 'gcc' 'wayland-protocols')
source=("$pkgname-$pkgver.tar.gz::https://github.com/MonoEven/Autohotkey_Linux/archive/refs/tags/v2.0.26-linux.17.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S . -B build-core -G Ninja \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build build-core
}

package() {
  install -Dm755 "$srcdir"/build-core/source/linux/core/ahk_core \
    "$pkgdir"/usr/share/autohotkey/ahk_core
  # Official upstream AutoHotkey icon: SNI pixmap + freedesktop theme name.
  install -Dm644 "$srcdir"/source/resources/icon_main.ico \
    "$pkgdir"/usr/share/autohotkey/icon_main.ico
  install -Dm644 "$srcdir"/docs-v2/docs/static/ahk16.png \
    "$pkgdir"/usr/share/autohotkey/autohotkey.png
  install -Dm644 "$srcdir"/docs-v2/docs/static/ahk16.png \
    "$pkgdir"/usr/share/icons/hicolor/16x16/apps/autohotkey.png
  # launcher: full --update/--uninstall/--check rendered from the shared
  # template; the package layout matches /usr, so the launcher's
  # install-method detection (pacman) works on Arch.
  sed -e 's|@PREFIX@|/usr|g' \
      -e 's|@LIB_SUB@|share/autohotkey|g' \
      -e 's|@BIN_SUB@|bin|g' \
      -e 's|@DOC_SUB@|share/doc/autohotkey|g' \
      -e "s|@AHK_VERSION@|$pkgver|g" \
      "$srcdir"/tools/linux/ahk-launcher.in > "$pkgdir/usr/bin/ahk"
  chmod 755 "$pkgdir/usr/bin/ahk"
  # docs
  install -d "$pkgdir/usr/share/doc/autohotkey"
  cp -r "$srcdir"/docs-v2 "$pkgdir/usr/share/doc/autohotkey/docs-v2"
  cp -r "$srcdir"/examples "$pkgdir/usr/share/doc/autohotkey/examples"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/autohotkey/README.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # GNOME Shell global-hotkey extension (system-wide; pacman lifecycle:
  # upgrades replace it, removal deletes it; enable per user via
  # gnome-extensions enable, see post_install below).
  EXT="$pkgdir/usr/share/gnome-shell/extensions/ahk-global-hotkeys@autohotkey.org"
  install -d "$EXT"
  install -Dm644 "$srcdir"/extension/ahk-global-hotkeys@autohotkey.org/metadata.json "$EXT/metadata.json"
  install -Dm644 "$srcdir"/extension/ahk-global-hotkeys@autohotkey.org/extension.js "$EXT/extension.js"
}

post_install() {
  echo
  echo "AutoHotkey GNOME Shell extension installed system-wide."
  echo "To use zero-confirmation global hotkeys on GNOME Wayland, do ONCE"
  echo "per user while logged into the GNOME session:"
  echo "    gnome-extensions enable ahk-global-hotkeys@autohotkey.org"
  echo "then restart GNOME Shell (log out/in, or Alt+F2 and type 'r')."
  echo "(removing the package will delete the extension too.)"
}

post_upgrade() {
  post_install
}

post_remove() {
  # Extension files are tracked by pacman and removed with the package;
  # nothing extra to do.  (A user-enabled extension stays enabled in
  # their gsettings; harmless once its files are gone.)
  true
}
