{
  "comments": {
    "lineComment": ";",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*;\\s*#region\\b",
      "end": "^\\s*;\\s*#endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(^.*\\{[^}]*$)|(^\\s*(if|else|loop|while|for|try|catch|finally|class|switch)\\b.*$)",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@#$%^&*()=+[\\]{}\\\\|;:'\\\",.<>/?\\s]+)"
}
