{
  "name": "autohotkey-linux-tools",
  "displayName": "AutoHotkey Linux Tools",
  "description": "Run AutoHotkey v2 Linux scripts and inspect input-backend capabilities from VS Code.",
  "version": "0.2.0",
  "publisher": "autohotkey-linux-community",
  "license": "GPL-2.0-or-later",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "autohotkey",
    "ahk",
    "linux",
    "wayland",
    "x11"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Running AutoHotkey scripts executes workspace code. Trust the workspace first."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "A local filesystem and native ahk_core process are required."
    }
  },
  "activationEvents": [
    "onLanguage:ahk2",
    "onCommand:ahkLinux.runFile",
    "onCommand:ahkLinux.runSelection",
    "onCommand:ahkLinux.showDiagnostics",
    "onCommand:ahkLinux.detachDebugger",
    "onCommand:ahkLinux.reconnectDebugger",
    "onView:ahkLinux.capabilities",
    "onDebug:ahk-linux"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@3.6.2 package"
  },
  "contributes": {
    "languages": [
      {
        "id": "ahk2",
        "aliases": [
          "AutoHotkey v2",
          "AHK v2"
        ],
        "extensions": [
          ".ahk",
          ".ah2"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^#!.*(?:AutoHotkey|ahk_core)"
      }
    ],
    "grammars": [
      {
        "language": "ahk2",
        "scopeName": "source.ahk2",
        "path": "./syntaxes/ahk2.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "ahk-linux",
        "label": "AutoHotkey Linux DBGp",
        "languages": [
          "ahk2"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "AutoHotkey script to debug."
              },
              "runtime": {
                "type": "string",
                "description": "Path to the DBGp-enabled ahk_core runtime. Defaults to ahkLinux.runtime."
              },
              "runtimeArgs": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Debuggee working directory."
              },
              "backend": {
                "type": "string",
                "enum": ["auto", "x11", "portal", "gnome-shell", "evdev"],
                "default": "auto"
              },
              "inputdSocket": {
                "type": "string",
                "default": ""
              }
            }
          },
          "attach": {
            "required": ["processId", "port"],
            "properties": {
              "processId": {
                "type": "integer",
                "description": "PID of a detached ahk_core process launched with --debug."
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "Original DBGp IDE host."
              },
              "port": {
                "type": "integer",
                "description": "Original DBGp IDE port retained by the debuggee."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ahk-linux",
            "request": "launch",
            "name": "Debug current AutoHotkey file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "AutoHotkey Linux: Debug current file",
            "description": "Launch the current AHK v2 script with the native Linux DBGp runtime.",
            "body": {
              "type": "ahk-linux",
              "request": "launch",
              "name": "Debug current AutoHotkey file",
              "program": "${file}"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "ahkLinux.runFile",
        "title": "AutoHotkey Linux: Run Current File",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.runSelection",
        "title": "AutoHotkey Linux: Run Selection",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.stop",
        "title": "AutoHotkey Linux: Stop Running Script",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.detachDebugger",
        "title": "AutoHotkey Linux: Detach Debugger (Keep Script Running)",
        "category": "AutoHotkey Linux",
        "enablement": "inDebugMode"
      },
      {
        "command": "ahkLinux.reconnectDebugger",
        "title": "AutoHotkey Linux: Reconnect Last Detached Debuggee",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.showDiagnostics",
        "title": "AutoHotkey Linux: Show Runtime Diagnostics",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.refreshCapabilities",
        "title": "AutoHotkey Linux: Refresh Backend Capabilities",
        "category": "AutoHotkey Linux"
      },
      {
        "command": "ahkLinux.openLinuxDocs",
        "title": "AutoHotkey Linux: Open Linux Port Documentation",
        "category": "AutoHotkey Linux"
      }
    ],
    "configuration": {
      "title": "AutoHotkey Linux",
      "properties": {
        "ahkLinux.runtime": {
          "type": "string",
          "default": "ahk",
          "description": "Path to the AutoHotkey Linux launcher/interpreter executable."
        },
        "ahkLinux.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments inserted before the script path."
        },
        "ahkLinux.workingDirectory": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Working directory for scripts. Supports ${workspaceFolder} and ${fileDirname}."
        },
        "ahkLinux.inputBackend": {
          "type": "string",
          "enum": [
            "auto",
            "x11",
            "portal",
            "gnome-shell",
            "evdev"
          ],
          "default": "auto",
          "description": "AHK_INPUT_BACKEND value for launched scripts."
        },
        "ahkLinux.inputdSocket": {
          "type": "string",
          "default": "",
          "description": "Optional AHK_INPUTD_SOCKET path. Empty uses the runtime default."
        },
        "ahkLinux.clearOutputBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the AutoHotkey Linux output channel before each run."
        },
        "ahkLinux.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the current document before running it."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "ahk-linux",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "Script path; ${file} is supported."
          },
          "backend": {
            "type": "string",
            "description": "Optional input backend override."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ahk-linux",
        "owner": "ahk-linux",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?\\.(?:ahk|ah2))\\s*\\((\\d+)(?:,\\s*(\\d+))?\\)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ahkLinux.capabilities",
          "name": "AHK Linux Capabilities",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "ahkLinux.runFile",
          "when": "editorLangId == ahk2",
          "group": "run@1"
        }
      ],
      "editor/context": [
        {
          "command": "ahkLinux.runSelection",
          "when": "editorLangId == ahk2 && editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "ahkLinux.refreshCapabilities",
          "when": "view == ahkLinux.capabilities",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ahkLinux.runFile",
        "key": "f6",
        "when": "editorLangId == ahk2"
      },
      {
        "command": "ahkLinux.stop",
        "key": "shift+f6",
        "when": "editorLangId == ahk2"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MonoEven/Autohotkey_Linux"
  },
  "homepage": "https://github.com/MonoEven/Autohotkey_Linux",
  "bugs": {
    "url": "https://github.com/MonoEven/Autohotkey_Linux/issues"
  }
}
